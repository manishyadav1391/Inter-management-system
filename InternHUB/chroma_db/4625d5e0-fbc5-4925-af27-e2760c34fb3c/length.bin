{"chroma:document":"\n    CREATE TABLE interns (\n      id UUID PRIMARY KEY,\n      user_id UUID NOT NULL,\n      department_id UUID NOT NULL,\n      name TEXT NOT NULL,\n      gender TEXT,\n      phone TEXT,\n      institute_id UUID,\n      start_date DATE,\n      end_date DATE,\n      status_id UUID,\n      created_at TIMESTAMP,\n      updated_at TIMESTAMP,\n      deleted_at TIMESTAMP\n    );\n 